# nobridge.co — FINAL (heydeal.co fully retired 2026-07-05).
# The heydeal.co / ops.heydeal.co blocks are GONE: the domain is being reused
# for an unrelated project. Old links are dead by design. The /finance redirect
# on crm.nobridge.co stays: users with a cached pre-migration CRM bundle still
# click a relative /finance switcher entry until their cache expires.

crm.nobridge.co {
    encode zstd gzip

    # Legacy path from cached overlay bundles (see header note).
    # route{} forces listed order — bare directives would run redir BEFORE uri
    # (Caddy directive order) and leak the /finance prefix into the target.
    @finpath path /finance /finance/*
    handle @finpath {
        route {
            uri strip_prefix /finance
            redir https://fin.nobridge.co{uri} 301
        }
    }

    handle {
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        @fonts path /fonts/*
        header @fonts Cache-Control "public, max-age=31536000, immutable"

        @images path /images/*
        header @images Cache-Control "public, max-age=86400"

        reverse_proxy 127.0.0.1:3000
    }
}

# Nobridge Finance at its own subdomain root (image built with empty
# NEXT_PUBLIC_BASE_PATH). The app performs its own auth (Google sign-in +
# CRM-role session); /submit and /api/public/* are its public surface — no
# Caddy gating on purpose.
fin.nobridge.co {
    encode zstd gzip

    # Claude connector fix (2026-07-28). Adding fin.nobridge.co/mcp/<token> as a
    # custom connector failed with "Couldn't register with Nobridge Finance's
    # sign-in service". Cause: the MCP client probes OAuth discovery + dynamic
    # client registration (RFC 7591/8414) BEFORE connecting. Those paths don't
    # exist in the app, but Next's middleware (no matcher, runs on every request)
    # 307s them to /login, which answers 200 text/html — so the client believed an
    # OAuth server was there and choked parsing the HTML as JSON. Returning a bare
    # 404 tells it "no OAuth here", and it falls back to the URL-path token the
    # /mcp/:token route actually uses. node.nobridge.co never hit this because its
    # equivalent probe ends in 501, not 200.
    # None of these are real app routes (verified against app/ — no register,
    # authorize, token or .well-known handlers), so nothing is being shadowed.
    @oauth_probe path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource* /.well-known/openid-configuration* /register
    handle @oauth_probe {
        respond 404
    }

    handle {
        reverse_proxy 127.0.0.1:3100
    }
}

# Nobridge Automations — ops dashboard.
node.nobridge.co {
    encode zstd gzip

    # The ops MCP connector was REMOVED 2026-08-07 with the pipeline engines. Old
    # /mcp/<token> connector URLs are dead — answer 404 rather than falling through
    # to the dashboard, which would serve its HTML login page and make a stale
    # Claude connector fail with a confusing sign-in error instead of a clean 404.
    handle /mcp/* {
        respond 404
    }

    # Ops dashboard — the app performs its own Google sign-in + CRM-role session
    # (Admin/Manager only), mirroring fin.nobridge.co. No Caddy gating on purpose;
    # /login and /api/auth/* are its public surface, everything else self-gates.
    handle {
        reverse_proxy 127.0.0.1:3200
    }
}
