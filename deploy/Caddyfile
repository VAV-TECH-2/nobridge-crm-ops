heydeal.co {
    encode zstd gzip

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    @fonts path /fonts/*
    header @fonts Cache-Control "public, max-age=31536000, immutable"

    @images path /images/*
    header @images Cache-Control "public, max-age=86400"

    reverse_proxy 127.0.0.1:3000
}
