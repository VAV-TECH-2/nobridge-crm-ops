# nobridge.co — UNIFIED (2026-10-01). One origin for the whole system:
#
#   app.nobridge.co/          Twenty CRM          127.0.0.1:3000
#   app.nobridge.co/finance   Nobridge Finance    127.0.0.1:3100  (Next basePath /finance)
#   app.nobridge.co/ops       Ops dashboard       127.0.0.1:3200  (prefix stripped here)
#
# One origin is what gives one sign-in: Finance and Ops read the CRM's own
# session cookie (tokenPair, path /) and ask Twenty who it belongs to. Neither
# has a login flow of its own any more.
#
# The old hostnames crm., fin. and node.nobridge.co were RETIRED on 2026-10-01:
# every machine client moved here first (CRM API, Google OAuth callbacks, AI
# Access /ai/*, Finance /finance/mcp + /finance/api/agent), their traffic was
# watched in Caddy logs, then their DNS records (A + SPF TXT) were deleted.
# Backup of those records: deploy/unify/dns-records-deleted-20261001.json.

app.nobridge.co {
    encode zstd gzip

    # MCP clients probe OAuth discovery + dynamic client registration before
    # connecting. Twenty answers these at the root with its OWN OAuth server
    # metadata (and the SPA's 200 HTML for the path-suffixed forms), which makes
    # a client try to sign in through the CRM and fail — the fin.nobridge.co
    # lesson of 2026-07-28. Our connectors (/ai/mcp/<token>, /finance/mcp/<token>)
    # take the token in the URL, so this host has no OAuth: a bare 404 sends
    # clients straight to the token. Twenty's own OAuth/MCP is unused here
    # (checked 2026-10-01: no registered OAuth clients).
    @oauth_probe path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource* /.well-known/openid-configuration* /register
    handle @oauth_probe {
        respond 404
    }

    # AI Access — the CRM connector for Claude (MCP, token in the path) and
    # ChatGPT (Bearer). Its own token auth and its own port; it serves /ai/* itself.
    handle /ai/* {
        request_body {
            max_size 1MB
        }
        reverse_proxy 127.0.0.1:3300
    }

    # Finance builds with basePath /finance, so it expects the prefix: no strip.
    @finance path /finance /finance/*
    handle @finance {
        reverse_proxy 127.0.0.1:3100
    }

    # The dashboard page fetches relative api/... URLs, which only resolve under
    # /ops/ with the trailing slash.
    redir /ops /ops/ 308

    # The dashboard serves at its root; DASH_BASE_PATH=/ops re-adds the prefix
    # to its redirects and cookie paths.
    handle_path /ops/* {
        reverse_proxy 127.0.0.1:3200
    }

    handle {
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        @fonts path /fonts/*
        header @fonts Cache-Control "public, max-age=31536000, immutable"

        @images path /images/*
        header @images Cache-Control "public, max-age=86400"

        reverse_proxy 127.0.0.1:3000
    }
}
